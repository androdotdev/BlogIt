{
  "name": "blogit",
  "private": true,
  "version": "1.0.0",
  "description": "BlogIt — turn any webpage into a beautiful reading experience.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:pages && npm run build:content",
    "build:pages": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/themes": "^3.3.0",
    "dompurify": "^3.3.0",
    "marked": "^18.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
