{
  "manifest_version": 3,
  "name": "BlogIt: Reader Mode",
  "short_name": "BlogIt",
  "version": "1.0.0",
  "description": "Turn any cluttered webpage into a clean, beautiful blog reading experience.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "BlogIt: Reader mode",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "Toggle BlogIt reader mode"
    }
  }
}
